# .env.example — секреты Джарвиса (раунд 21, A4).
#
# Скопируй в .env (без .example) в корне проекта и заполни своими
# значениями. .env НЕ кладём в git (см. .gitignore, если используешь git) -
# в отличие от config/config.yaml, где лежат все НЕсекретные настройки.
#
# Формат — обычный KEY=value, по одному на строку, без пробелов вокруг "=".
# Строки, начинающиеся с "#", и пустые строки игнорируются.

# Обязательно для LLM-слоя (раунд 4). Бесплатный ключ:
# https://openrouter.ai/keys
LLM_API_KEY=sk-or-...

# Опционально - только если используешь личный бэкенд (agents/tools/backend.py)
# и он защищён API-ключом.
JARVIS_BACKEND_API_KEY=

# Опционально (раунд 23, B6) - только если у локального fallback-сервера
# (LM Studio и т.п.) настроена проверка ключа. Базовый URL и имя модели -
# в config/config.yaml (llm_fallback.*), не здесь - это не секреты.
LLM_FALLBACK_API_KEY=
